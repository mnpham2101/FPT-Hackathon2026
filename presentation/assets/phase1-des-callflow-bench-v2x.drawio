        <mxCell id="pb6" value="Start-up — inside each node, no traffic on the network" style="rounded=0;html=1;fillColor=#eef1f8;strokeColor=none;align=left;spacingLeft=10;fontSize=16.1;fontStyle=1;fontColor=#19226D;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="1120" height="26" as="geometry" /></mxCell>
        <mxCell id="sf7" value="load configuration, validate the scenario file" style="html=1;endArrow=block;strokeColor=#034EA2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="214" as="sourcePoint" /><mxPoint x="210" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="sf8" value="start the encoder helper process" style="html=1;endArrow=block;strokeColor=#034EA2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="268" as="sourcePoint" /><mxPoint x="210" y="294" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="sf9" value="init · configure · subscribe — each call acknowledged" style="html=1;endArrow=block;strokeColor=#19226D;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="214" as="sourcePoint" /><mxPoint x="620" y="240" as="targetPoint" /></mxGeometry></mxCell>
