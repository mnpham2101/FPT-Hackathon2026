        <mxCell id="pb11" value="Live loop — ten messages per second, the only traffic in Phase 1" style="rounded=0;html=1;fillColor=#eef1f8;strokeColor=none;align=left;spacingLeft=10;fontSize=16.1;fontStyle=1;fontColor=#19226D;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1120" height="26" as="geometry" /></mxCell>
