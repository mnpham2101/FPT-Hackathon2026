        <mxCell id="t1" value="The detector — one pipeline behind a frame-source seam" style="text;html=1;align=left;verticalAlign=middle;fontSize=25.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="t2" value="Phase 3 replaced the recorded fixture with real perception. Nothing above the seam knows where a frame came from." style="text;html=1;align=left;verticalAlign=middle;fontSize=17.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="b3" value="the committed clip&#10;1280x720 · 20 fps · 10.0 s&#10;an image layer, not a stream" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=13.2;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="250" height="78" as="geometry" /></mxCell>
        <mxCell id="b4" value="the synthetic clip&#10;a CI decode fixture only" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=13.2;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="b5" value="frame_source   seam&#10;FileFrameSource&#10;SyntheticFrameSource" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#33B2C1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=14.0;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="147" as="sourcePoint" /><mxPoint x="320" y="160" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e7" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#F37021;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=14.0;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="230" as="sourcePoint" /><mxPoint x="320" y="185" as="targetPoint" /><Array as="points"><mxPoint x="300" y="230" /><mxPoint x="300" y="185" /></Array></mxGeometry></mxCell>
        <mxCell id="b8" value="pacer" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="t9" value="hold each sampled frame&#10;until its own deadline" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="176" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="b10" value="inference" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="t11" value="YOLO11n ONNX on CPU&#10;resize, overlap suppression, class collapse" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="296" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="b12" value="distance" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="370" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="t13" value="pinhole known-width range&#10;and lateral offset" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="416" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="b14" value="tracker" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="490" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="t15" value="greedy overlap association&#10;against the previous frame" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="536" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="e16" value="every Nth decoded frame" style="html=1;endArrow=block;endFill=1;strokeColor=#19226D;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="170" as="sourcePoint" /><mxPoint x="620" y="152" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e17" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#19226D;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=14.0;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="174" as="sourcePoint" /><mxPoint x="890" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e18" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=14.0;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="294" as="sourcePoint" /><mxPoint x="890" y="370" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e19" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=14.0;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="414" as="sourcePoint" /><mxPoint x="890" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b20" value="emit" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="490" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="t21" value="one R3 JSONL line per detection, carrying&#10;a stable own:n id from the association" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="980" y="536" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="e22" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#19226D;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=14.0;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="512" as="sourcePoint" /><mxPoint x="980" y="512" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b23" value="the core&#x27;s detector_reader" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="e24" value="stdout pipe" style="html=1;endArrow=block;endFill=1;strokeColor=#33B2C1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="490" as="sourcePoint" /><mxPoint x="1130" y="174" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b25" value="Why a pinhole known-width range&#10;&#10;A user-supplied clip carries no intrinsics and no ground-plane calibration,&#10;and a monocular-depth network is a second model on a CPU-only node. The&#10;bbox-bottom alternative needs camera height and pitch — more unknowns, not&#10;fewer.&#10;&#10;What the gate needs is a monotonic, consistently biased range over the&#10;occluder, which this delivers. When the estimate disagrees with the scenario&#10;the two camera constants are retuned — never the admission gate." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="286" width="560" height="192" as="geometry" /></mxCell>
        <mxCell id="b26" value="Why the frames are paced&#10;&#10;Each sampled frame is held until a computed deadline on the monotonic clock,&#10;so clip time and run time are the same second. The deadline is computed rather&#10;than accumulated: a fixed sleep per frame folds the inference cost into&#10;scenario time and drifts without bound over a run.&#10;&#10;Without pacing no instant in the demo choreography is expressible, which is&#10;why it is load-bearing rather than a preference." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="486" width="560" height="180" as="geometry" /></mxCell>
        <mxCell id="b27" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="590" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="t28" value="seam or fixture" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="662" y="588" width="120" height="20" as="geometry" /></mxCell>
        <mxCell id="b29" value="" style="rounded=1;arcSize=3;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="782.15" y="590" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="t30" value="business logic" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="804.15" y="588" width="112" height="20" as="geometry" /></mxCell>
        <mxCell id="b31" value="" style="rounded=1;arcSize=3;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="917.0899999999999" y="590" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="t32" value="controller" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="939.0899999999999" y="588" width="84" height="20" as="geometry" /></mxCell>
        <mxCell id="b33" value="" style="rounded=1;arcSize=3;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1023.1899999999999" y="590" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="t34" value="outside the process" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1045.19" y="588" width="148" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
