        <mxCell id="m0" value="R1 CPM — UPER bytes on udp :47100, ten per second" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#034EA2;strokeWidth=1.7;fontSize=13.2;fontColor=#3d3d46;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="151" y="214" as="sourcePoint" /><mxPoint x="429" y="214" as="targetPoint" /></mxGeometry></mxCell>
