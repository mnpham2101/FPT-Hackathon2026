        <mxCell id="m1l" value="decode, validate, deduplicate, and derive the distance" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#3d3d46;" vertex="1" parent="1"><mxGeometry x="505" y="258" width="460" height="16" as="geometry" /></mxCell>
        <mxCell id="m2" value="R2 JSON — one perceived-object update, udp :47200" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#33B2C1;strokeWidth=1.7;fontSize=13.2;fontColor=#3d3d46;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="441" y="322" as="sourcePoint" /><mxPoint x="759" y="322" as="targetPoint" /></mxGeometry></mxCell>
