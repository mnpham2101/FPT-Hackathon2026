        <mxCell id="m3l" value="parse, gate and confirm VehicleC; the store is the single writer" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#3d3d46;" vertex="1" parent="1"><mxGeometry x="835" y="366" width="460" height="16" as="geometry" /></mxCell>
        <mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#19226D;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="386" as="sourcePoint" /><mxPoint x="771" y="408" as="targetPoint" /><Array as="points"><mxPoint x="825" y="386" /><mxPoint x="825" y="408" /></Array></mxGeometry></mxCell>
        <mxCell id="m4l" value="the clip&#x27;s own-sensor VehicleB — inside the pod, never on the wire" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#3d3d46;" vertex="1" parent="1"><mxGeometry x="835" y="400" width="460" height="16" as="geometry" /></mxCell>
        <mxCell id="m5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#19226D;strokeWidth=1.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="420" as="sourcePoint" /><mxPoint x="771" y="442" as="targetPoint" /><Array as="points"><mxPoint x="825" y="420" /><mxPoint x="825" y="442" /></Array></mxGeometry></mxCell>
        <mxCell id="m5l" value="fusion tick: compose d_AC, band it, hold it for the dwell" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#3d3d46;" vertex="1" parent="1"><mxGeometry x="835" y="434" width="460" height="16" as="geometry" /></mxCell>
        <mxCell id="m6" value="R4 JSON warning — one datagram per committed risk change, udp 47300" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#F37021;strokeWidth=1.7;fontSize=13.2;fontColor=#3d3d46;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="771" y="492" as="sourcePoint" /><mxPoint x="1169" y="492" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="note" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="508" width="1260" height="96" as="geometry" /></mxCell>
        <mxCell id="nt0" value="In the isolated Room the two neighbours are ada-bench roles at the same addresses: v2x_mock sends the R2 stream, ivi_mock binds 47300 and checks every warning. This node&#x27;s" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#3d3d46;" vertex="1" parent="1"><mxGeometry x="42" y="523" width="1230" height="16" as="geometry" /></mxCell>
        <mxCell id="nt1" value="image, command, capabilities and env are identical in both Rooms, so a difference between the runs is a finding about a neighbour." style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#3d3d46;" vertex="1" parent="1"><mxGeometry x="42" y="545" width="1230" height="16" as="geometry" /></mxCell>
        <mxCell id="nt2" value="VehicleC never appears in the clip, so VehicleC reaches the store only along the relayed path. That is a property of the footage rather than a filter in the code — the R19 claim rests on it." style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#3d3d46;" vertex="1" parent="1"><mxGeometry x="42" y="567" width="1230" height="16" as="geometry" /></mxCell>
