        <mxCell id="t2" value="Both wires are one way: nothing returns to this node. The bench and the display are each an address, so a stand-in and the real node are interchangeable." style="text;html=1;align=left;verticalAlign=middle;fontSize=17.0;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="24" y="52" width="1272" height="20" as="geometry" /></mxCell>
