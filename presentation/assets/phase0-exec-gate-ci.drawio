        <mxCell id="t19" value="Exit 1 on any byte difference, so a node-local copy can" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="45" y="345" width="321" height="16" as="geometry" /></mxCell>
