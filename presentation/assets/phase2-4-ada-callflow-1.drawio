        <mxCell id="e12" value="config load — the only read of the environment" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.0" y="242" as="sourcePoint" /><mxPoint x="481.0" y="268" as="targetPoint" /><Array as="points"><mxPoint x="625.0" y="242" /><mxPoint x="625.0" y="268" /></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="register the built-in plugins,&#10;enable the CRA_ENABLED subset" style="html=1;endArrow=block;endFill=1;strokeColor=#F37021;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="481.0" y="322" as="sourcePoint" /><mxPoint x="789.0" y="322" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e14" value="bind udp :47200 and start the receive thread" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.0" y="384" as="sourcePoint" /><mxPoint x="481.0" y="410" as="targetPoint" /><Array as="points"><mxPoint x="625.0" y="384" /><mxPoint x="625.0" y="410" /></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="spawn DETECTOR_CMD, keep the stdout pipe" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="481.0" y="464" as="sourcePoint" /><mxPoint x="1124.0" y="464" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e16" value="detector_spawn on the [EVT] stream" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1124.0" y="506" as="sourcePoint" /><mxPoint x="481.0" y="506" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b17" value="The fixture configuration runs this identical wiring with DETECTOR_CMD pointed at a recorded JSONL stream, so the core runs whole with no model and no clip. There is no mock branch&#10;anywhere in the core, which is what makes the fixture run evidence about the real code.&#10;The detector&#x27;s warm-up — the ONNX session load and the clip open — precedes its first emitted line. That interval is the run origin the demo choreography is aligned against, and it&#10;is still unmeasured on the deployed node." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="522" width="1260" height="88" as="geometry" /></mxCell>
      </root>
