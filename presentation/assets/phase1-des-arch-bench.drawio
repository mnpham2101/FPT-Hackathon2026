        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#33B2C1;" edge="1" parent="1" source="scn" target="model"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
