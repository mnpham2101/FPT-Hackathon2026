        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#034EA2;" edge="1" parent="1" source="scn" target="enc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#F37021;" edge="1" parent="1" source="enc" target="helper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#034EA2;" edge="1" parent="1" source="snd" target="wire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n11" value="Responsibility split::
data — the scenario files and the content record;
logic — the kinematic model, and the codec inside the helper;
control — main.py, the rate loop, and the two input/output edges.
There is no user interface: the transmission log is the observation point." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=15.4;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="560" height="118" as="geometry" /></mxCell>
        <mxCell id="n12" value="Why a separate helper process::
the encoder is the same C++ codec the V2X ECU decodes with,
so the bench cannot re-implement it in Python without risking
divergence. The sources are copied byte-identically and the
output is verified against the reference messages." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=15.4;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="410" width="520" height="118" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
