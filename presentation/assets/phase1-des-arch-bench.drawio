        <mxCell id="t1" value="Scenario Player — module architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=23.8;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="1152" height="20" as="geometry" /></mxCell>
        <mxCell id="t2" value="One Python process and one C++ helper process. Every module has a single responsibility." style="text;html=1;align=left;verticalAlign=middle;fontSize=16.8;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1152" height="20" as="geometry" /></mxCell>
        <mxCell id="main" value="main.py
entrypoint and composition;
no logic of its own" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="cfg" value="player/config.py
environment and scenario file;
the sole environment reader" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="yaml" value="scenarios/*.yaml
two committed traffic situations;
every tunable value" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="scn" value="player/scenario.py
constant-velocity model:
