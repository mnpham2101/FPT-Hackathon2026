        <mxCell id="gen" value="player/generator.py
rate loop and scenario clock" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="112" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="enc" value="player/encoder_client.py
drives the helper over
