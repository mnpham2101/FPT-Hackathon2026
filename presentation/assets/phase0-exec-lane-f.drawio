<mxfile host="app.diagrams.net">
  <diagram name="phase0-exec-lane-f" id="phase0-exec-lane-f">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Lane F — the smoke test: strictly sequential, and the only lane a human had to finish" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="13" width="766" height="26" as="geometry" /></mxCell>
        <mxCell id="t2" value="Lane F — the smoke test: strictly sequential, and the only lane a human had to finish" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#19226D;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1140" height="22" as="geometry" /></mxCell>
        <mxCell id="t3" value="Group 0.8. Fully parallel with lanes A–E: it shares no file with them." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="24" y="40" width="445" height="18" as="geometry" /></mxCell>
        <mxCell id="t4" value="Group 0.8. Fully parallel with lanes A–E: it shares no file with them." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1140" height="18" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;6.0.8.1&lt;/b&gt;&lt;br&gt;author the netcheck tool&lt;br&gt;4 files, verbatim from the note&lt;br&gt;step M1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8E6FB8;fontSize=11;fontColor=#19226D;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="25" y="110" width="250" height="96" as="geometry" /></mxCell>
        <mxCell id="t6" value="agent" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="133" y="215" width="40" height="16" as="geometry" /></mxCell>
        <mxCell id="b7" value="&lt;b&gt;5.0.8.2&lt;/b&gt;&lt;br&gt;build, tag and push the image&lt;br&gt;one image, three container nodes&lt;br&gt;steps M2–M4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#F37021;fontSize=11;fontColor=#19226D;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="305" y="110" width="250" height="96" as="geometry" /></mxCell>
        <mxCell id="t8" value="car-sky agent" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="395" y="215" width="76" height="16" as="geometry" /></mxCell>
        <mxCell id="b9" value="&lt;b&gt;5.0.8.3&lt;/b&gt;&lt;br&gt;node config + deploy&lt;br&gt;every node Running, restarts 0&lt;br&gt;steps M5–M9  →  C1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#034EA2;fontSize=11;fontColor=#19226D;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="585" y="110" width="250" height="96" as="geometry" /></mxCell>
        <mxCell id="t10" value="user, in the Nydus UI" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="652" y="215" width="122" height="16" as="geometry" /></mxCell>
        <mxCell id="b11" value="&lt;b&gt;6.0.8.4&lt;/b&gt;&lt;br&gt;read each node's View Log&lt;br&gt;zero errors, live logs, capture, chain&lt;br&gt;steps M10–M12  →  C2–C5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#034EA2;fontSize=11;fontColor=#19226D;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="865" y="110" width="250" height="96" as="geometry" /></mxCell>
        <mxCell id="t12" value="user, in the Nydus UI" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="932" y="215" width="122" height="16" as="geometry" /></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8a8d99;endArrow=classic;fontSize=10;" edge="1" parent="1" source="b5" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8a8d99;endArrow=classic;fontSize=10;" edge="1" parent="1" source="b7" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8a8d99;endArrow=classic;fontSize=10;" edge="1" parent="1" source="b9" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b16" value="&lt;b&gt;closed on the way through&lt;/b&gt;&lt;br&gt;O1 — the registry host that actually answers  ·  O2 — the NET_RAW capability is honoured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#50B848;fontSize=11;fontColor=#19226D;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="25" y="262" width="530" height="62" as="geometry" /></mxCell>
        <mxCell id="b17" value="&lt;b&gt;left open on purpose&lt;/b&gt;&lt;br&gt;O3 — the MTU probe was optional and not run  ·  O4 — the AAOS listener check was unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8d99;fontSize=11;fontColor=#19226D;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="585" y="262" width="530" height="62" as="geometry" /></mxCell>
        <mxCell id="t18" value="Hop 3 into the IVI node has indirect evidence only: the ADA node's own transmit and capture lines prove the datagram left the bridge for the IVI address, not that it arrived." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="24" y="344" width="1061" height="17" as="geometry" /></mxCell>
        <mxCell id="t19" value="The image also had to be rebuilt single-platform for arm64 before any node could pull it — a multi-platform manifest left the nodes provisioning forever." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="24" y="366" width="933" height="17" as="geometry" /></mxCell>
        <mxCell id="t20" value="This is the one Phase 0 acceptance box closed by a live deployment rather than by a green CI run." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#19226D;" vertex="1" parent="1"><mxGeometry x="24" y="388" width="591" height="17" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
