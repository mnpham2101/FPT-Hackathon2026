        <mxCell id="e19" value="ingest and&#10;transition lines" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1011.0" y="466" as="sourcePoint" /><mxPoint x="1229.0" y="466" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b20" value="The store is the sole writer of a track&#x27;s state. A detector line or a relayed object arrives carrying not_tracked by convention and that value is discarded, so nothing outside the&#10;store can claim a track is confirmed.&#10;Neither namespace can be minted by the other side: the detector cannot produce a v2x: id and the relay cannot produce an own: id. That is what makes the zero-VehicleC claim structural&#10;rather than a filter." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="502" width="1260" height="88" as="geometry" /></mxCell>
      </root>
