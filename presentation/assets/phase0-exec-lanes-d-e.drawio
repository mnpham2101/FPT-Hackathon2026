        <mxCell id="t25" value="Both supersede an already-numbered Phase 5 subtask;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="630" y="289" width="297" height="16" as="geometry" /></mxCell>
        <mxCell id="t26" value="ownership was reconciled and no ID was renumbered." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="630" y="306" width="292" height="16" as="geometry" /></mxCell>
        <mxCell id="t27" value="Lane E is the one lane whose test command could not run at all on the dev host: the local JDK exceeds the Gradle wrapper's supported range, so CI is the authority." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="24" y="356" width="993" height="17" as="geometry" /></mxCell>
        <mxCell id="t28" value="Lane D's single subtask ran first of the three still open once the golden vectors landed, precisely because it was the only locally verifiable one." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="24" y="378" width="896" height="17" as="geometry" /></mxCell>
        <mxCell id="t29" value="Neither lane could have been pulled earlier: their inputs are frozen contract artifacts, not effort." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="24" y="400" width="610" height="17" as="geometry" /></mxCell>
