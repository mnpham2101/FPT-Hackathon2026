        <mxCell id="b40" value="IPv4 · static addresses 10.99.0.10–.13 · same subnet, so no routing and no gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a35a0;strokeColor=#2a35a0;strokeWidth=1;fontColor=#ffffff;fontSize=14.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="408" width="1060" height="44" as="geometry" /></mxCell>
