        <mxCell id="b38" value="UDP — one PDU per datagram · ports 47100 / 47200 / 47300 · no broker, no middleware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#19226D;strokeColor=#19226D;strokeWidth=1;fontColor=#ffffff;fontSize=14.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="352" width="1060" height="44" as="geometry" /></mxCell>
