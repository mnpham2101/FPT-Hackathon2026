        <mxCell id="n13" value="The check lane is the phase's own acceptance made repeatable: it runs the&#10;assembled binary against a recorded input file and a test sender, then asserts&#10;the resulting event stream — and runs it a second time with the input switched&#10;off, where the expected result is no tracked vehicle at all." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=15.4;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="700" height="93.6" as="geometry" /></mxCell>
