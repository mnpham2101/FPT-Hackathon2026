        <mxCell id="lnko" value="OSI 2" style="text;html=1;align=right;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="-336" y="415" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="app1" value="" style="rounded=1;arcSize=6;html=1;fillColor=#f2f4f9;strokeColor=#dfe2ea;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="300" y="168" width="450" height="74" as="geometry" /></mxCell>
        <mxCell id="app1a" value="UTF-8 JSON, one object per datagram" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="225" y="184" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="app1b" value="parsed by nlohmann/json into the R2 binding" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="225" y="206" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="app1c" value="unknown fields ignored" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="225" y="224" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="app2" value="" style="rounded=1;arcSize=6;html=1;fillColor=#f2f4f9;strokeColor=#dfe2ea;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="790" y="168" width="450" height="74" as="geometry" /></mxCell>
        <mxCell id="app2a" value="UTF-8 JSON, one object per datagram" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="715" y="184" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="app2b" value="built by nlohmann/json from the R4 binding" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="715" y="206" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="app2c" value="the R3 track nested inside it" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="715" y="224" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="tra1" value="" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#dfe2ea;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="450" height="60" as="geometry" /></mxCell>
        <mxCell id="tra1a" value="UDP  ·  bound 0.0.0.0:47200" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="225" y="264" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="tra1b" value="no retransmission, no ordering, no framing" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="225" y="284" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="tra2" value="" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#dfe2ea;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="790" y="250" width="450" height="60" as="geometry" /></mxCell>
        <mxCell id="tra2a" value="UDP  ·  sent to 10.99.0.13:47300" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="715" y="264" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="tra2b" value="one message per datagram, fire and forget" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="715" y="284" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="net1" value="" style="rounded=1;arcSize=6;html=1;fillColor=#eef1f8;strokeColor=#dfe2ea;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="300" y="318" width="940" height="58" as="geometry" /></mxCell>
        <mxCell id="net1a" value="IPv4  ·  static addresses on 10.99.0.0/24, this node at 10.99.0.12" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="332" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="net1b" value="no routing and no gateway — every peer is on the one subnet" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="352" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="lnk1" value="" style="rounded=1;arcSize=6;html=1;fillColor=#19226D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="384" width="940" height="50" as="geometry" /></mxCell>
        <mxCell id="lnk1a" value="Simulated Ethernet  ·  the CarSky Ethernet Bridge node, one L2 segment" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="395" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="lnk1b" value="the pod has no physical interface; the bridge is the medium" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#c9d2f5;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="414" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="dbox" value="" style="rounded=1;arcSize=10;html=1;fillColor=#fdf4ee;strokeColor=#F37021;strokeWidth=1.8;dashed=1;" vertex="1" parent="1"><mxGeometry x="24" y="470" width="1272" height="126" as="geometry" /></mxCell>
        <mxCell id="dh" value="Outside the stack — the detector channel" style="text;html=1;align=left;verticalAlign=middle;fontSize=16.5;fontColor=#B04E10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="490" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="dtag" value="" style="rounded=1;arcSize=22;html=1;fillColor=#ffffff;strokeColor=#F37021;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="900" y="478" width="352" height="44" as="geometry" /></mxCell>
        <mxCell id="dtaga" value="R3  ·  TrackedObject" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#B04E10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="776" y="486" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="dtagb" value="an application-layer message, and nothing below it" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="776" y="503" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="d1" value="The ADA Core — the node&#x27;s C++ process — spawns the detector as a child process in the same container: argv in, exit code out, R3 on standard output." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="530" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="d2" value="An OS pipe supplies no addressing, no ports and no message framing, so newlines delimit the messages and nothing sits beneath the JSON." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="554" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="d3" value="The pipe is ordered and lossless, and blocks when its buffer fills, where UDP would discard the datagram." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="578" width="600" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
