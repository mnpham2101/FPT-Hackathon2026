        <mxCell id="tran" value="Transport" style="text;html=1;align=right;verticalAlign=middle;fontSize=16;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-336" y="268" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="trao" value="OSI 4" style="text;html=1;align=right;verticalAlign=middle;fontSize=13.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="-336" y="286" width="600" height="20" as="geometry" /></mxCell>
