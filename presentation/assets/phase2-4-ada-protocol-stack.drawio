        <mxCell id="appn" value="Application" style="text;html=1;align=right;verticalAlign=middle;fontSize=16;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-336" y="193" width="600" height="20" as="geometry" /></mxCell>
