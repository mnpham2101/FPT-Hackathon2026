        <mxCell id="t1" value="The ADA node&#x27;s protocol stack" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="26" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="t2" value="Two channels cross the network. The detector reaches the ADA Core through a pipe, not as a network peer." style="text;html=1;align=left;verticalAlign=middle;fontSize=16.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="600" height="20" as="geometry" /></mxCell>
