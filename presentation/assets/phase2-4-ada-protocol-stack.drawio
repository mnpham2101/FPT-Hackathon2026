<mxfile host="app.diagrams.net">
  <diagram name="phase2-4-ada-protocol-stack" id="phase2-4-ada-protocol-stack">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="The ADA node&#x27;s protocol stack — three channels, one transport, one encoding" style="text;html=1;align=left;verticalAlign=middle;fontSize=25.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="t2" value="Two channels cross the network; the third never leaves the pod. Nothing here touches UPER, so the node carries no ASN.1 codec." style="text;html=1;align=left;verticalAlign=middle;fontSize=17.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="t3" value="Message" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="250" height="20" as="geometry" /></mxCell>
        <mxCell id="t4" value="what is carried" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="250" height="18" as="geometry" /></mxCell>
        <mxCell id="t5" value="Encoding" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="250" height="20" as="geometry" /></mxCell>
        <mxCell id="t6" value="bytes as written" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="250" height="18" as="geometry" /></mxCell>
        <mxCell id="t7" value="Library" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="256" width="250" height="20" as="geometry" /></mxCell>
        <mxCell id="t8" value="third party" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="276" width="250" height="18" as="geometry" /></mxCell>
        <mxCell id="t9" value="Channel" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="250" height="20" as="geometry" /></mxCell>
        <mxCell id="t10" value="how it moves" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="250" height="18" as="geometry" /></mxCell>
        <mxCell id="b11" value="R2 in  ·  V2X ECU to ADA" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="92" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="b12" value="R3  ·  detector to core" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="92" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="b13" value="R4 out  ·  ADA to IVI" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="92" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="b14" value="v2x_object&#10;one perceived-object update" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="134" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b15" value="TrackedObject&#10;one own-sensor detection" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="134" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b16" value="warning event&#10;risk state and composed scene" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="134" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b17" value="UTF-8 JSON  ·  versioned  ·  one JSON Schema per contract  ·  one message per datagram or per line" style="rounded=1;arcSize=10;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="198" width="1000" height="44" as="geometry" /></mxCell>
        <mxCell id="b18" value="nlohmann/json&#10;C++ · MIT" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b19" value="nlohmann/json  +  Python stdlib json&#10;one binding per side of the boundary" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b20" value="nlohmann/json&#10;C++ · MIT" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="250" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b21" value="UDP datagram&#10;bind 0.0.0.0:47200" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="314" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b22" value="stdout pipe&#10;argv in, exit code out" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="314" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b23" value="UDP datagram&#10;send to 10.99.0.13:47300" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="314" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="b24" value="IPv4 · static 10.99.0.12" style="rounded=1;arcSize=10;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="320" height="40" as="geometry" /></mxCell>
        <mxCell id="b25" value="IPv4 · static 10.99.0.13" style="rounded=1;arcSize=10;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="380" width="320" height="40" as="geometry" /></mxCell>
        <mxCell id="b26" value="no network layer — one pod" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#e3e6f0;fontColor=#6b6e7b;fontSize=14.0;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="380" width="320" height="40" as="geometry" /></mxCell>
        <mxCell id="t27" value="Network" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="388" width="250" height="20" as="geometry" /></mxCell>
        <mxCell id="b28" value="R6 — the CarSky Ethernet Bridge Node, one L2 segment 10.99.0.0/24" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="1000" height="40" as="geometry" /></mxCell>
        <mxCell id="t29" value="Link" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="438" width="250" height="20" as="geometry" /></mxCell>
        <mxCell id="b30" value="Everything from the encoding row down is shared by the two network channels. The process channel stops at the pod: it has no network and no link layer, which is the whole point of&#10;joining the two processes by stdout rather than by a socket.&#10;The frozen R3 schema is the shape on both the JSONL line and the object field of every R4 warning — one schema, two crossing points, so a perception source can be swapped without&#10;touching the consumer.&#10;Deliberately absent: Vanetza, because this node never sees a CPM; any database engine, because the assessment table is in process and its writes leave through the event stream." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="1260" height="106" as="geometry" /></mxCell>
        <mxCell id="b31" value="tcpdump is the fourth channel and carries no message: capture.sh writes readable [CAP] lines and rotating pcap files, because R15 and R19 need a record of ADA-to-IVI traffic that&#10;the V2X ECU&#x27;s capture point cannot see." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1260" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
