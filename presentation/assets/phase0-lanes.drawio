        <mxCell id="ciD2" value="pytest, guarded on requirements-dev.txt and tests/ existing" style="text;html=1;align=left;fontSize=11;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="762" y="368" width="518" height="18" as="geometry" /></mxCell>

        <mxCell id="ciE1" value="ivi-unit-tests" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#034EA2;fontColor=#034EA2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="408" width="160" height="26" as="geometry" /></mxCell>
        <mxCell id="ciE2" value="Gradle on temurin JDK 17 — the local JDK exceeds Gradle 8.13's range" style="text;html=1;align=left;fontSize=11;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="762" y="438" width="518" height="18" as="geometry" /></mxCell>

        <mxCell id="ciF1" value="netcheck-image" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#034EA2;fontColor=#034EA2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="478" width="160" height="26" as="geometry" /></mxCell>
        <mxCell id="ciF2" value="builds and pushes the image; C1–C5 are observed on the platform, not in CI" style="text;html=1;align=left;fontSize=11;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="762" y="508" width="518" height="18" as="geometry" /></mxCell>

        <mxCell id="note1" value="Lanes are logical dependency structure, not concurrency — at run time every subtask executes sequentially in one working tree." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6ef;strokeColor=#F37021;fontColor=#3d3d46;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="548" width="1240" height="34" as="geometry" /></mxCell>
        <mxCell id="note2" value="A CI lane lands before the code it verifies, guarded on file existence, so it stays green until its consumer arrives." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ee;strokeColor=#50B848;fontColor=#3d3d46;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1240" height="34" as="geometry" /></mxCell>
        <mxCell id="note3" value="Phase 1 adds four jobs to the same file — v2x-comms-check · sp-codec-helper · v2x-ecu-image · scenario-player-image (10 jobs total).&lt;br&gt;Its plan-side lanes are V (V2X_ECU/) · P (Scenario_Player/) · D (deploy — user-manual, no CI lane)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f6;strokeColor=#c9cbd6;fontColor=#3d3d46;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1240" height="52" as="geometry" /></mxCell>
