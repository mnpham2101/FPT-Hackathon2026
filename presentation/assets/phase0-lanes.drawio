        <mxCell id="ciB2" value="cmake + ctest + the golden-vector determinism check (Vanetza deps cached)" style="text;html=1;align=left;fontSize=11;fontColor=#6b6e7b;" vertex="1" parent="1"><mxGeometry x="762" y="228" width="518" height="18" as="geometry" /></mxCell>

