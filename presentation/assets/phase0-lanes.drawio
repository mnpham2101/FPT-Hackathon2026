        <mxCell id="chainA" value="1.0.1.1 → 1.0.1.2 · 2.0.1.3 · 3.0.1.4 → 4.0.1.5 → 4.0.1.6 → 1.0.7.1&lt;br&gt;&lt;font color=&quot;#6b6e7b&quot; style=&quot;font-size:11px&quot;&gt;R1 profile · R1–R4 schemas · shared samples · byte-identity gate (last)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cbd6;fontColor=#19226D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="222" y="120" width="500" height="62" as="geometry" /></mxCell>
        <mxCell id="chainB" value="1.0.2.1 → 1.0.2.2 → 1.0.2.3 → 1.0.2.4 → 1.0.2.5 · 2.0.3.1&lt;br&gt;&lt;font color=&quot;#6b6e7b&quot; style=&quot;font-size:11px&quot;&gt;CMake toolchain · codec seam · VanetzaCpmCodec · gv_tool · golden vectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cbd6;fontColor=#19226D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="222" y="190" width="500" height="62" as="geometry" /></mxCell>
        <mxCell id="chainC" value="3.0.4.1 → { 2.0.3.2 ∥ 3.0.4.2 } → 4.0.4.3 → 4.0.4.4 → 3.0.4.5&lt;br&gt;&lt;font color=&quot;#6b6e7b&quot; style=&quot;font-size:11px&quot;&gt;C++ toolchain · R2/R3/R4 bindings · additive-version test · detector Python&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cbd6;fontColor=#19226D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="222" y="260" width="500" height="62" as="geometry" /></mxCell>
        <mxCell id="chainD" value="1.0.1.2 + 1.0.2.4 → 1.0.5.1&lt;br&gt;&lt;font color=&quot;#6b6e7b&quot; style=&quot;font-size:11px&quot;&gt;bench CpmContent dataclass · round-trip over the golden .json side&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cbd6;fontColor=#19226D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="222" y="330" width="500" height="62" as="geometry" /></mxCell>
        <mxCell id="chainE" value="4.0.1.5 → 4.0.6.1 → 4.0.6.2&lt;br&gt;&lt;font color=&quot;#6b6e7b&quot; style=&quot;font-size:11px&quot;&gt;sealed Kotlin R4 binding · finalized R3 models · additive-version test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cbd6;fontColor=#19226D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="222" y="400" width="500" height="62" as="geometry" /></mxCell>
