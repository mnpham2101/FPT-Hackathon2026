        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#19226D;" edge="1" parent="1" source="net" target="seam"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="290" /><mxPoint x="165" y="250" /><mxPoint x="300" y="250" /><mxPoint x="300" y="148" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#19226D;" edge="1" parent="1" source="seam" target="stub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
