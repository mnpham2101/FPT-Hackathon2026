        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#19226D;" edge="1" parent="1" source="codec" target="pipe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="338" /><mxPoint x="620" y="172" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#19226D;" edge="1" parent="1" source="pipe" target="fwd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#19226D;" edge="1" parent="1" source="pipe" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="148" /><mxPoint x="910" y="338" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#19226D;" edge="1" parent="1" source="r2b" target="fwd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="434" /><mxPoint x="620" y="245" /></Array></mxGeometry></mxCell>
        <mxCell id="n11" value="Two containment rules define the design::
no module other than src/net/ may include a socket header, and the
check is enforced on every push; and the radio interface mirrors the
production modem's API, so replacing the simulation changes nothing
above it. The link to the ADA node is deliberately outside that
interface: it stays UDP on production hardware." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=15.4;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="560" height="138" as="geometry" /></mxCell>
        <mxCell id="n12" value="Responsibility split::
data — configuration, the message bindings, the event log;
logic — the four pipeline stages and the modem state machine;
control — main.cpp and the adapter, which mediate between the
transport edge and the pipeline.
There is no user interface: the event and capture streams are it." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=15.4;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="500" width="520" height="138" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
