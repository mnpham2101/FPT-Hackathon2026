<mxfile host="app.diagrams.net">
  <diagram name="phase1-des-arch-v2x" id="phase1-des-arch-v2x">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="690" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="V2X ECU — module architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=23.8;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="1152" height="20" as="geometry" /></mxCell>
        <mxCell id="t2" value="One process and one receive thread. Only two modules are permitted to touch the operating system." style="text;html=1;align=left;verticalAlign=middle;fontSize=16.8;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1152" height="20" as="geometry" /></mxCell>
        <mxCell id="main" value="src/main.cpp
composition and start-up;
no logic of its own" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="cfg" value="src/config/
the sole environment reader" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="net" value="src/net/
the sole holder of sockets" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="cap" value="capture.sh
traffic capture, separate process" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="seam" value="src/adapter/
the frozen radio interface
and its implementation" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="stub" value="src/stub/
simulated modem: state machine,
faults and recoveries" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="codec" value="src/codec/
decoder for the air message
(delivered in Phase 0)" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="r2b" value="src/contracts/
the object-message binding
(delivered in Phase 0)" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="396" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="pipe" value="src/pipeline/
four stages: validate, deduplicate,
build, compose" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="250" height="76" as="geometry" /></mxCell>
