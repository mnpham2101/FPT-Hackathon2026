        <mxCell id="b7" value="v2x_listener&#10;R2 receive thread" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="260" y="142" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="b8" value="detector_reader&#10;subprocess + stdout" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="476" y="142" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="b9" value="input_queue&#10;two producers, one consumer" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="692" y="142" width="228" height="54" as="geometry" /></mxCell>
        <mxCell id="b10" value="r2_parser&#10;R2 to TrackedObject" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="260" y="206" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="b11" value="r3_parser&#10;JSONL to TrackedObject" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="476" y="206" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="b12" value="R4 output stage&#10;warning_builder · ivi_sender" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="692" y="206" width="228" height="54" as="geometry" /></mxCell>
        <mxCell id="b13" value="udp_socket&#10;sole socket-API holder" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="44" y="206" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="t14" value="business logic — pure functions of their inputs" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#034EA2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="274" width="360" height="18" as="geometry" /></mxCell>
        <mxCell id="b15" value="admission&#10;R13 machine, one for both sources" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="44" y="296" width="276" height="58" as="geometry" /></mxCell>
        <mxCell id="b16" value="chained_collision&#10;the M1 NLOS plugin, bands and dwell" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="336" y="296" width="276" height="58" as="geometry" /></mxCell>
        <mxCell id="b17" value="scene_composer&#10;d_AC = d_AB + d_BC&#10;lateral, component-wise" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=13.2;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="628" y="296" width="292" height="58" as="geometry" /></mxCell>
        <mxCell id="t18" value="seams and lookup" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#F37021;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="366" width="200" height="18" as="geometry" /></mxCell>
        <mxCell id="b19" value="ICollisionRiskAssessment&#10;the R14 interface" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="44" y="388" width="276" height="50" as="geometry" /></mxCell>
        <mxCell id="b20" value="registry + builtin_plugins&#10;one line adds a plugin" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="336" y="388" width="276" height="50" as="geometry" /></mxCell>
        <mxCell id="t21" value="data — models and stores, holding no rules" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#33B2C1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="450" width="340" height="18" as="geometry" /></mxCell>
        <mxCell id="b22" value="contracts&#10;frozen R2/R3/R4 bindings" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="44" y="472" width="214" height="52" as="geometry" /></mxCell>
        <mxCell id="b23" value="track_store&#10;the R3 objects, one writer" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="272" y="472" width="214" height="52" as="geometry" /></mxCell>
        <mxCell id="b24" value="assessment_db&#10;the R14 record table" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="472" width="214" height="52" as="geometry" /></mxCell>
        <mxCell id="b25" value="config · event_log&#10;sole env reader · [EVT]" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="728" y="472" width="192" height="52" as="geometry" /></mxCell>
        <mxCell id="t26" value="No layer is collapsed: admission cannot reach a socket, a plugin cannot send a datagram, and the detector cannot reach the store." style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="536" width="880" height="18" as="geometry" /></mxCell>
        <mxCell id="t27" value="Its only route in is one JSONL line through a parser." style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="558" width="880" height="18" as="geometry" /></mxCell>
        <mxCell id="b28" value="main — argv, wiring, exit codes" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="974" y="122" width="302" height="44" as="geometry" /></mxCell>
        <mxCell id="b29" value="frame_source  seam&#10;file clip | synthetic | future live" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=13.2;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="974" y="176" width="302" height="44" as="geometry" /></mxCell>
