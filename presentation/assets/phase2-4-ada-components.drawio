        <mxCell id="b31" value="inference — YOLO11n ONNX, CPU" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="974" y="280" width="302" height="44" as="geometry" /></mxCell>
        <mxCell id="b32" value="distance — pinhole known-width" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="974" y="334" width="302" height="40" as="geometry" /></mxCell>
        <mxCell id="b33" value="tracker — greedy overlap association" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="974" y="384" width="302" height="40" as="geometry" /></mxCell>
        <mxCell id="b34" value="emit — R3 JSONL on stdout" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="974" y="434" width="302" height="40" as="geometry" /></mxCell>
        <mxCell id="b35" value="contracts — the R3 Python binding" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="974" y="484" width="302" height="40" as="geometry" /></mxCell>
        <mxCell id="t36" value="Joined to the core only by argv,&#10;exit codes and stdout. No FFI, no RPC." style="text;html=1;align=center;verticalAlign=middle;fontSize=13.2;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="974" y="532" width="302" height="40" as="geometry" /></mxCell>
