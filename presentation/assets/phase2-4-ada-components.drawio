        <mxCell id="t46" value="seam — a provided interface meeting a required one" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="353.88" y="608" width="360" height="20" as="geometry" /></mxCell>
        <mxCell id="b47" value="Four components the HLD names but its MVC table does not place: udp_socket, registry, the detector&#x27;s frame_source and the detector&#x27;s own config reader. They are drawn here as the&#10;controller&#x27;s socket holder, a lookup, and two seams — reported to architecture rather than assigned on a slide." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="636" width="1264" height="74" as="geometry" /></mxCell>
