        <mxCell id="t1" value="Component architecture — two processes, three layers" style="text;html=1;align=left;verticalAlign=middle;fontSize=25.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="t2" value="Every component has one responsibility. The layer a component sits in fixes what it may touch." style="text;html=1;align=left;verticalAlign=middle;fontSize=17.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="g3" value="ada_ecu core — C++17, one process, three threads" style="rounded=1;arcSize=6;html=1;fillColor=none;strokeColor=#19226D;fontColor=#19226D;fontSize=14.0;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="28" y="92" width="908" height="500" as="geometry" /></mxCell>
        <mxCell id="g4" value="detector — Python 3.11 subprocess" style="rounded=1;arcSize=6;html=1;fillColor=none;strokeColor=#034EA2;fontColor=#034EA2;fontSize=14.0;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="958" y="92" width="334" height="500" as="geometry" /></mxCell>
        <mxCell id="t5" value="controller — the clock, the threads, the sockets" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.2;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="120" width="360" height="18" as="geometry" /></mxCell>
