        <mxCell id="pbA" value="Boot — configuration and the helper process, before any datagram" style="rounded=0;html=1;fillColor=#eef1f8;strokeColor=none;align=left;spacingLeft=10;fontSize=16.1;fontStyle=1;fontColor=#19226D;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="1120" height="26" as="geometry" /></mxCell>
        <mxCell id="a1" value="load the environment, then load and validate the scenario file" style="html=1;endArrow=block;strokeColor=#034EA2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="212" as="sourcePoint" /><mxPoint x="120" y="234" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a2" value="start the encoder" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="126" y="262" as="sourcePoint" /><mxPoint x="594" y="262" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a3" value="spawn the subprocess, open the pipes" style="html=1;endArrow=block;endFill=1;strokeColor=#19226D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="292" as="sourcePoint" /><mxPoint x="834" y="292" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="pbB" value="Rate loop — ten times per second, until the scenario ends" style="rounded=0;html=1;fillColor=#eef1f8;strokeColor=none;align=left;spacingLeft=10;fontSize=16.1;fontStyle=1;fontColor=#19226D;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="1120" height="26" as="geometry" /></mxCell>
        <mxCell id="a4" value="sample(t)" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="126" y="366" as="sourcePoint" /><mxPoint x="354" y="366" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a5" value="the object's state at scenario time t" style="html=1;endArrow=open;dashed=1;strokeColor=#6b6e7b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="394" as="sourcePoint" /><mxPoint x="126" y="394" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a6" value="encode(content)" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="126" y="424" as="sourcePoint" /><mxPoint x="594" y="424" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a7" value="one JSON line on standard input" style="html=1;endArrow=block;endFill=1;strokeColor=#19226D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="452" as="sourcePoint" /><mxPoint x="834" y="452" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a8" value="the UPER bytes, base64 on standard output" style="html=1;endArrow=open;dashed=1;strokeColor=#6b6e7b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="480" as="sourcePoint" /><mxPoint x="606" y="480" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a9" value="send(bytes) — one datagram, 58 bytes nominal" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="126" y="510" as="sourcePoint" /><mxPoint x="1074" y="510" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="a10" value="[TX] one log line: sequence, scenario time, byte count" style="html=1;endArrow=block;strokeColor=#034EA2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="524" as="sourcePoint" /><mxPoint x="120" y="546" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n1" value="An encode error costs one datagram: the client raises, the loop logs&#10;[ENC-SKIP] and the next tick sends normally." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=15.4;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="545" height="52" as="geometry" /></mxCell>
        <mxCell id="n2" value="If the subprocess dies, the client respawns it with backoff. The bench&#10;stays alive and keeps logging, which is what makes the failure visible." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=15.4;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="615" y="560" width="545" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
