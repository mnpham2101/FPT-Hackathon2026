<mxfile host="app.diagrams.net">
  <diagram name="phase2-4-ada-admission" id="phase2-4-ada-admission">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="The R13 admission machine — one machine, both perception sources" style="text;html=1;align=left;verticalAlign=middle;fontSize=25.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="t2" value="not_tracked means absent from the store, not an entry flagged not_tracked. A drop erases the entry." style="text;html=1;align=left;verticalAlign=middle;fontSize=17.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="b3" value="not_tracked&#10;absent from the store" style="rounded=1;arcSize=10;html=1;fillColor=#6b6e7b;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="250" height="66" as="geometry" /></mxCell>
        <mxCell id="b4" value="tentative&#10;in the store, confirming" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="250" height="66" as="geometry" /></mxCell>
        <mxCell id="b5" value="tracked&#10;published to the assessment" style="rounded=1;arcSize=10;html=1;fillColor=#50B848;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="250" height="66" as="geometry" /></mxCell>
        <mxCell id="b6" value="" style="rounded=1;arcSize=3;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=16.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="118" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#19226D;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=14.0;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="56" y="131" as="sourcePoint" /><mxPoint x="80" y="150" as="targetPoint" /><Array as="points"><mxPoint x="80" y="131" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="update within the enter gate&#10;create the entry, hits = 1" style="html=1;endArrow=block;endFill=1;strokeColor=#19226D;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="172" as="sourcePoint" /><mxPoint x="530" y="172" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e9" value="hits reach the confirm count" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="172" as="sourcePoint" /><mxPoint x="980" y="172" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e10" value="update within the enter gate — hits + 1" style="html=1;endArrow=block;endFill=1;strokeColor=#F37021;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="150" as="sourcePoint" /><mxPoint x="600" y="150" as="targetPoint" /><Array as="points"><mxPoint x="655" y="112" /><mxPoint x="600" y="112" /></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="update within the exit gate — refresh" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105" y="150" as="sourcePoint" /><mxPoint x="1050" y="150" as="targetPoint" /><Array as="points"><mxPoint x="1105" y="112" /><mxPoint x="1050" y="112" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="update beyond the enter gate — erase, hits = 0" style="html=1;endArrow=block;endFill=1;strokeColor=#F37021;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="216" as="sourcePoint" /><mxPoint x="205" y="216" as="targetPoint" /><Array as="points"><mxPoint x="600" y="276" /><mxPoint x="205" y="276" /></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="silence past the timeout — erase, hits = 0" style="html=1;endArrow=block;endFill=1;strokeColor=#F37021;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="216" as="sourcePoint" /><mxPoint x="255" y="216" as="targetPoint" /><Array as="points"><mxPoint x="680" y="330" /><mxPoint x="255" y="330" /></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="update beyond the exit gate — the hysteresis drop" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="216" as="sourcePoint" /><mxPoint x="155" y="216" as="targetPoint" /><Array as="points"><mxPoint x="1050" y="386" /><mxPoint x="155" y="386" /></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="silence past the timeout — erase, hits = 0" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="216" as="sourcePoint" /><mxPoint x="105" y="216" as="targetPoint" /><Array as="points"><mxPoint x="1130" y="440" /><mxPoint x="105" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="b16" value="What one update is&#10;&#10;relayed C — one relayed object message, and the range it reports&#10;own-sensor B — one detector line, and the range it estimates&#10;&#10;The two sources run at independently configured cadences, which is why&#10;the machine is parameterized only by what counts as an update." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="476" width="622" height="216" as="geometry" /></mxCell>
        <mxCell id="b17" value="Why the timeout is a time and not a count&#10;&#10;The requirement&#x27;s own wording is that a track&#x27;s messages stop, and a counter&#10;cannot express silence — nothing arrives to increment it. One count across two&#10;cadences would also mean two different real timeouts, so retuning another&#10;node&#x27;s rate would silently change this node&#x27;s behaviour.&#10;&#10;It is measured on a monotonic stamp the store keeps beside each entry, so a&#10;host clock step cannot expire every track at once." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="668" y="476" width="622" height="216" as="geometry" /></mxCell>
        <mxCell id="b18" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="t19" value="tentative edges" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="52" y="698" width="120" height="20" as="geometry" /></mxCell>
        <mxCell id="b20" value="" style="rounded=1;arcSize=3;html=1;fillColor=#50B848;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="172.15" y="700" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="t21" value="tracked edges" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="194.15" y="698" width="105" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
