<mxfile host="app.diagrams.net">
  <diagram name="cpm-message-structure" id="cpm-message-structure">
    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CPM message structure — what the Scenario Player sends to the V2X ECU (R1 / R11)" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1000" height="22" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="ETSI TS 103 324 v2.1.1 · ASN.1 UPER · one PDU per UDP datagram · encoded by the shared R1 codec (Vanetza r2::Cpm)" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1000" height="18" as="geometry" /></mxCell>

        <mxCell id="msg" value="&lt;b&gt;CollectivePerceptionMessage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="740" height="790" as="geometry" /></mxCell>

        <mxCell id="hdr" value="&lt;b&gt;header : ItsPduHeader&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;protocolVersion&amp;nbsp; = 2&lt;br&gt;messageId&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; = &lt;b&gt;cpm (14)&lt;/b&gt;&amp;nbsp; — the CPM/DENM discriminator&lt;br&gt;stationId&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; = 1201&amp;nbsp; (vehicle B, the sender)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="700" height="86" as="geometry" /></mxCell>

        <mxCell id="payload" value="&lt;b&gt;payload : CpmPayload&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="700" height="632" as="geometry" /></mxCell>

        <mxCell id="mgmt" value="&lt;b&gt;managementContainer : ManagementContainer&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;referenceTime&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; : TimestampIts&amp;nbsp; — 0,001 s since 2004-01-01 TAI&lt;br&gt;referencePosition : ReferencePosition&amp;nbsp; — B&#39;s WGS84 pose&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;latitude / longitude&amp;nbsp; (10⁻⁷ degree)&amp;nbsp; · positionConfidenceEllipse · altitude&lt;br&gt;&lt;i style=&quot;color:#888888&quot;&gt;segmentationInfo? · messageRateRange?&amp;nbsp; — unused in M1&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="248" width="660" height="104" as="geometry" /></mxCell>

        <mxCell id="wrapped" value="&lt;b&gt;cpmContainers : WrappedCpmContainers&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;SEQUENCE (SIZE 1..8) — M1 sends exactly 2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="368" width="660" height="452" as="geometry" /></mxCell>

        <mxCell id="ovc" value="&lt;b&gt;containerId = 1&amp;nbsp; ·&amp;nbsp; OriginatingVehicleContainer&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;orientationAngle : Wgs84Angle&amp;nbsp; { value (0,1°, 0..3601) , confidence }&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 900 = 90,0° East&amp;nbsp; → maps to R2 sender.heading&lt;br&gt;&lt;i style=&quot;color:#888888&quot;&gt;pitchAngle? · rollAngle? · trailerDataSet?&amp;nbsp; — unused in M1&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="408" width="620" height="92" as="geometry" /></mxCell>

        <mxCell id="f1note" value="&lt;b&gt;F1&lt;/b&gt;&amp;nbsp; No speed field in release 2 — R2 sender.speed must be derived" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="506" width="620" height="24" as="geometry" /></mxCell>

        <mxCell id="poc" value="&lt;b&gt;containerId = 5&amp;nbsp; ·&amp;nbsp; PerceivedObjectContainer&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;numberOfPerceivedObjects : CardinalNumber1B&amp;nbsp; = &lt;b&gt;1&lt;/b&gt;&amp;nbsp; (vehicle C)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="540" width="620" height="262" as="geometry" /></mxCell>

        <mxCell id="po" value="&lt;b&gt;perceivedObjects[0] : PerceivedObject&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;— vehicle C as measured by B&lt;/span&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;objectId&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; : Identifier2B&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0..65535&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; = 7&lt;br&gt;measurementDeltaTime&amp;nbsp; : DeltaTimeMilliSecondSigned&amp;nbsp;&amp;nbsp; ±2047 ms&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; = −50&lt;br&gt;position&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; : CartesianPosition3dWithConfidence&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; xCoordinate / yCoordinate&amp;nbsp; { value (0,01 m) , confidence }&amp;nbsp; = 2500 / 120&lt;br&gt;velocity?&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; : Velocity3dWithConfidence → cartesianVelocity&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; xVelocity / yVelocity&amp;nbsp; { value (0,01 m/s) , confidence }&amp;nbsp; = 1520&lt;br&gt;classification?&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; : ObjectClassDescription (SIZE 1..8)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; [0].objectClass.vehicleSubClass = passengerCar (5)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; [0].confidence : ConfidenceLevel&amp;nbsp; 1..101&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; = 95&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="606" width="580" height="176" as="geometry" /></mxCell>

        <mxCell id="unused" value="&lt;i&gt;containerId 2 OriginatingRsu&amp;nbsp; ·&amp;nbsp; 3 SensorInformation&amp;nbsp; ·&amp;nbsp; 4 PerceptionRegion&amp;nbsp; — not sent in M1&lt;/i&gt;" style="text;html=1;align=left;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="82" y="792" width="620" height="18" as="geometry" /></mxCell>

        <mxCell id="wire" value="&lt;b&gt;Wire&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;Scenario Player&amp;nbsp; 10.99.0.10&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; ↓&amp;nbsp; UDP · raw UPER · no BTP/GN envelope (F5)&lt;br&gt;V2X ECU&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 10.99.0.11 : 47100&lt;br&gt;&lt;br&gt;10 Hz default · one CPM per datagram&lt;br&gt;fire-and-forget · no ack, no session, no auth&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="790" y="108" width="380" height="140" as="geometry" /></mxCell>

        <mxCell id="profile" value="&lt;b&gt;M1 profile — the whole message&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;· 1 header + 1 management container&lt;br&gt;· exactly 2 wrapped containers: id 1 and id 5&lt;br&gt;· exactly 1 perceived object (vehicle C)&lt;br&gt;· PerceivedObject&#39;s 14 other OPTIONAL fields&lt;br&gt;&amp;nbsp;&amp;nbsp; (acceleration, angles, dimensions, objectAge,&lt;br&gt;&amp;nbsp;&amp;nbsp; objectPerceptionQuality, sensorIdList,&lt;br&gt;&amp;nbsp;&amp;nbsp; correlation matrices, mapPosition) are&lt;br&gt;&amp;nbsp;&amp;nbsp; omitted — future extension points needing&lt;br&gt;&amp;nbsp;&amp;nbsp; no schema change&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="790" y="268" width="380" height="180" as="geometry" /></mxCell>

        <mxCell id="derived" value="&lt;b&gt;Derived at the V2X ECU, not transmitted&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;R2 object.distance = hypot(x, y)&amp;nbsp; &lt;b&gt;(F7)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp; → the input to R13 track admission (30 m)&lt;br&gt;R2 sender.speed&amp;nbsp; from consecutive referenceTime /&lt;br&gt;&amp;nbsp;&amp;nbsp; referencePosition deltas&amp;nbsp; &lt;b&gt;(F1)&lt;/b&gt;&lt;br&gt;R2 confidence 0–1&amp;nbsp; = ConfidenceLevel / 100&amp;nbsp; &lt;b&gt;(F6)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="790" y="468" width="380" height="130" as="geometry" /></mxCell>

        <mxCell id="notcpm" value="&lt;b&gt;Not CPM — DENM&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;messageId = denm (1)&lt;/span&gt;&lt;div style=&quot;font-size:11px;color:#444444;margin-top:6px&quot;&gt;management (actionId, detectionTime, eventPosition,&lt;br&gt;&amp;nbsp;&amp;nbsp; validityDuration) · situation (CauseCode /&lt;br&gt;&amp;nbsp;&amp;nbsp; SubCauseCode) · location · alacarte&lt;br&gt;&lt;br&gt;Carries an &lt;b&gt;event&lt;/b&gt;, never a perceived object&#39;s&lt;br&gt;position / velocity / class — so it cannot relay C.&lt;br&gt;&lt;b&gt;Not implemented in M1&lt;/b&gt;; named family for future&lt;br&gt;hazard types (one codec module + one R9&lt;br&gt;dispatch entry to add).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="790" y="618" width="380" height="176" as="geometry" /></mxCell>

        <mxCell id="legend" value="? = ASN.1 OPTIONAL&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp; grey italics = present in the standard, unused in M1&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp; Fn = finding in scenario-player-v2x-callflow-messages.md §6" style="text;html=1;align=left;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="20" y="866" width="1150" height="18" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
