        <mxCell id="t33" value="m1-r4-sim View Log — [TX] lines, one per warning sent, at the configured rate" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="80" y="434" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="b34" value="2" style="ellipse;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="47" y="453" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="t35" value="Guest logcat over ADB — [RX] with source=v2x_relayed, plus the crash buffer; the IVI node's own log is the VM host, not the app" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="80" y="458" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="b36" value="3" style="ellipse;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="47" y="477" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="t37" value="IVI Screen widget — the Warning View with ghost C dashed; the only surface that proves anything rendered" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="80" y="482" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="t38" value="No pcap on this path: m1-r4-sim runs no capture, so its log carries no [CAP] line and no block to extract." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="80" y="506" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="r39" value="" style="rounded=1;arcSize=8;html=1;fillColor=#fdf4ee;strokeColor=#F37021;strokeWidth=1.6;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="532" width="1260" height="44" as="geometry" /></mxCell>
        <mxCell id="t40" value="Rows 1 and 2 come from one command — tools\logs-collector\Collect-Logs.ps1 -Test 2, into test-report\ivi-isolated-test\. Row 3 stays manual, in the browser." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="549" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="t41" value="The IVI node pulls no image: it boots the AAOS VM artifact from Artifacts, and app-debug.apk is installed into the already-running guest over the ADB tunnel." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="596" width="600" height="20" as="geometry" /></mxCell>
      </root>
