        <mxCell id="t31" value="Where the evidence is captured" style="text;html=1;align=left;verticalAlign=middle;fontSize=16.5;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="408" width="600" height="20" as="geometry" /></mxCell>
