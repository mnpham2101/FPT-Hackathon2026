        <mxCell id="t1" value="Isolated IVI test — the app alone, its producer mocked" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="600" height="20" as="geometry" /></mxCell>
        <mxCell id="t2" value="Three nodes on one bridge. The ADA node replays R4 from a scenario file; the IVI node is a Skycraft VM with the team APK installed into it." style="text;html=1;align=left;verticalAlign=middle;fontSize=16.5;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="600" height="20" as="geometry" /></mxCell>
