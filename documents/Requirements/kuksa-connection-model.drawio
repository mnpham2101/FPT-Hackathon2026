<mxfile host="app.diagrams.net">
  <diagram name="connection-model" id="kuksa-connection-model">
    <mxGraphModel dx="1368" dy="788" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="450" math="0" shadow="0">
      <root>
