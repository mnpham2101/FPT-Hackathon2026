        <mxCell id="c8" value="vhal" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="ivigw" target="ivi"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="Every edge runs endpoint pin (OUTPUT) → hub pin (INPUT). Two endpoints never pair. Two hubs never pair.&lt;br&gt;A hub carries one INPUT pin and accepts many edges. Crossing from one hub to another always costs a gateway." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="405" width="1120" height="40" as="geometry" /></mxCell>
