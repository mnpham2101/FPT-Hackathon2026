        <mxCell id="title" value="Connection model — endpoints join a hub; only a script-node gateway crosses hubs" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="20" as="geometry" /></mxCell>

        <mxCell id="bms" value="BMS ECU&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="110" height="60" as="geometry" /></mxCell>
        <mxCell id="pwtcan" value="PWT CAN&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;hub · can-bus&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="185" width="115" height="60" as="geometry" /></mxCell>
        <mxCell id="pwtgw" value="PWT Gateway&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;script-node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="185" width="115" height="60" as="geometry" /></mxCell>

        <mxCell id="broker" value="Central Broker (VSS)&lt;br&gt;&lt;font color=&quot;#996600&quot; style=&quot;font-size:10px&quot;&gt;hub · kuksa-databroker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="150" height="70" as="geometry" /></mxCell>

        <mxCell id="tcugw" value="TCU Gateway&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;script-node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="115" height="60" as="geometry" /></mxCell>
        <mxCell id="tcusw" value="TCU Switch&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;hub · eth-bridge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="60" width="115" height="60" as="geometry" /></mxCell>
        <mxCell id="nad" value="TCU-NAD&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="60" width="110" height="60" as="geometry" /></mxCell>

        <mxCell id="ivigw" value="IVI Gateway&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;script-node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="310" width="115" height="60" as="geometry" /></mxCell>
        <mxCell id="ivi" value="IVI – Android&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;endpoint · skycraft&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="310" width="140" height="60" as="geometry" /></mxCell>

        <mxCell id="c1" value="can" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="bms" target="pwtcan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" value="can" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="pwtcan" target="pwtgw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" value="kuksa" style="endArrow=none;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="pwtgw" target="broker"><mxGeometry relative="1" as="geometry" /></mxCell>
