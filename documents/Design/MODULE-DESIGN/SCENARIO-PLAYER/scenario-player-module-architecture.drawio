        <mxCell id="cp_scen" value="«component» scenario&#10;constant-velocity kinematics in B's frame:&#10;B's static pose, C closing along x at&#10;closing_speed_mps; F9 bound asserted&#10;before the content is returned" style="rounded=1;arcSize=6;html=1;fillColor=#dbf1d7;strokeColor=#2E7D26;strokeWidth=1.8;verticalAlign=top;align=center;spacingTop=5;fontSize=15.0;fontStyle=1;fontColor=#245F1F;" vertex="1" parent="1"><mxGeometry x="440" y="178" width="328" height="140" as="geometry" /></mxCell>
