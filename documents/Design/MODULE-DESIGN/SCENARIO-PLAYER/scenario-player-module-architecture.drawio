        <mxCell id="cp_main" value="«component» main&#10;composition root and the blueprint&#10;entrypoint; [START] and [FATAL]" style="rounded=1;arcSize=6;html=1;fillColor=#fde3d3;strokeColor=#B04E10;strokeWidth=1.8;verticalAlign=top;align=center;spacingTop=5;fontSize=15.0;fontStyle=1;fontColor=#8A3D0C;" vertex="1" parent="1"><mxGeometry x="440" y="392" width="328" height="78" as="geometry" /></mxCell>
