@startuml skycraft-apk-delivery-routes

title Ways an APK can reach the Skycraft AAOS guest

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center

node "Build host or CI" as BUILD {
  component "app-debug.apk" as APK
}

cloud "CarSky control plane" as CP {
  component "REST API /api/v1" as REST
  component "Rework UI - Devices panel" as UI
  component "Artifact store" as ART
  component "Zot container registry" as ZOT
}

node "Room on Kubernetes" as ROOM {
  component "Skycraft node - AAOS guest" as GUEST
  component "Device Proxy node" as DP
  component "Container node" as CN
  component "Ethernet Bridge 10.99.0.0/24" as BR
}

APK --> REST : R1 adb-tunnel
APK --> REST : R3 adb-exec - no file transfer
APK --> UI : R2 ADB widget shell - no file transfer
APK --> ART : R6 inside a FAT32 usb .img
APK --> CN : R7 served over HTTP
APK --> ART : R9 baked into a custom AOSP image zip

REST --> GUEST : ADB over the tunnel
UI --> GUEST : adb part
ART --> DP : mounts the .img
DP --> GUEST : usb pin
ART --> GUEST : VM image at boot
CN --> BR
BR --> GUEST : ethernet pin
ZOT --> CN : container image only
ZOT ..> GUEST : no path exists

@enduml
