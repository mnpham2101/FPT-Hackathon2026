<mxfile host="app.diagrams.net">
  <diagram name="ivi-ecu-module-architecture" id="ivi-ecu-module-architecture">
    <mxGraphModel dx="1400" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="IVI ECU — module architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=23.8;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="14" width="1352" height="20" as="geometry" /></mxCell>
        <mxCell id="t2" value="One APK, one process, on the AAOS guest. A datagram becomes a rendered ghost C through one chain; every step of it is evidenced on one log tag." style="text;html=1;align=left;verticalAlign=middle;fontSize=16.8;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="1352" height="20" as="geometry" /></mxCell>
        <mxCell id="ada" value="ADA ECU node&#10;external — the R4 producer&#10;at 10.99.0.12; warning JSON&#10;over UDP to 10.99.0.13:47300" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#c8ccd8;fontColor=#19226D;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="100" width="248" height="100" as="geometry" /></mxCell>
        <mxCell id="sim" value="IVI_ECU/r4-simulator/&#10;test equipment: the m1-r4-sim&#10;image, run by the ADA node —&#10;never part of the APK" style="rounded=1;arcSize=8;html=1;fillColor=#fde3d3;strokeColor=#B04E10;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#B04E10;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="216" width="248" height="100" as="geometry" /></mxCell>
        <mxCell id="inj" value="debug/DevInjectorReceiver&#10;adb broadcast DEV_INJECT, on&#10;the same flow as a datagram;&#10;debug source set only" style="rounded=1;arcSize=8;html=1;fillColor=#fde3d3;strokeColor=#B04E10;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#B04E10;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="332" width="248" height="100" as="geometry" /></mxCell>
        <mxCell id="host" value="MainActivity · IviGraph&#10;launcher entry + composition&#10;root; R4ListenerService keeps&#10;the loop alive in foreground" style="rounded=1;arcSize=8;html=1;fillColor=#e0e3ec;strokeColor=#3B4462;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#3B4462;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="448" width="248" height="100" as="geometry" /></mxCell>
        <mxCell id="cfg" value="config/IviRuntimeConfig †&#10;BuildConfig defaults: port,&#10;timeout, scale; --ei override&#10;at launch. No literals" style="rounded=1;arcSize=8;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="572" width="248" height="100" as="geometry" /></mxCell>
        <mxCell id="man" value="AndroidManifest.xml †&#10;launcher intent filter, the&#10;service, automotive feature.&#10;Declares neither today" style="rounded=1;arcSize=8;html=1;fillColor=#4A5578;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="688" width="248" height="100" as="geometry" /></mxCell>
        <mxCell id="sock" value="observer/JdkDatagramSource&#10;the socket: binds 0.0.0.0:47300&#10;one datagram per receive, with&#10;length reset before every call" style="rounded=1;arcSize=8;html=1;fillColor=#dcdff0;strokeColor=#19226D;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#19226D;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="loop" value="observer/R4SocketObserver&#10;receive loop, truncation check,&#10;rebind back-off, link state;&#10;emits events, drops oldest" style="rounded=1;arcSize=8;html=1;fillColor=#dcdff0;strokeColor=#19226D;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#19226D;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="216" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="des" value="serializer/R4Deserializer&#10;slice → UTF-8 → R4Json; typed&#10;result, never throws. Malformed&#10;bytes become a [DROP]" style="rounded=1;arcSize=8;html=1;fillColor=#dcdff0;strokeColor=#19226D;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#19226D;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="332" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="model" value="contract/ — typed model&#10;R4Message · R3Snapshot ·&#10;SceneGeometry, with source;&#10;schemas in IVI_ECU/contracts/" style="rounded=1;arcSize=8;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="448" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="repo" value="data/R4Repository&#10;the event raiser: last warning,&#10;last state by seq, link state;&#10;also the dev injector's target" style="rounded=1;arcSize=8;html=1;fillColor=#d7eff3;strokeColor=#136472;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#136472;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="584" y="100" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="cls" value="warning/WarningClassifier&#10;wire warningType → presentation;&#10;unknown type and ahead-of-us&#10;schemaVersion degrade, no crash" style="rounded=1;arcSize=8;html=1;fillColor=#dcdff0;strokeColor=#19226D;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#19226D;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="584" y="216" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="wvm" value="ui/WarningViewModel&#10;Idle ↔ Active; auto-dismiss at&#10;WARNING_TIMEOUT_MS returns the&#10;Display Area to Idle" style="rounded=1;arcSize=8;html=1;fillColor=#d8e5f4;strokeColor=#034EA2;dashed=1;dashPattern=7 5;strokeWidth=2;fontColor=#034EA2;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="584" y="332" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="mvm" value="ui/MainViewModel †&#10;Warning / Home / Apps / Settings&#10;cause=warning vs cause=user.&#10;Built; wake-on-warning missing" style="rounded=1;arcSize=8;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="584" y="448" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="scr" value="ui/screen/MainScreen †&#10;Display Area, button areas,&#10;status bar. Warning View is a&#10;placeholder; link state unbound" style="rounded=1;arcSize=8;html=1;fillColor=#50B848;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="868" y="100" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="seam" value="ui/view/IviWarningViewSeam&#10;the render seam: 2D committed,&#10;optional 3D behind the same&#10;interface, no consumer change" style="rounded=1;arcSize=8;html=1;fillColor=#50B848;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="868" y="216" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="canv" value="ui/view/CanvasWarningView&#10;the God View — ego and B solid,&#10;ghost C dashed with risk glow&#10;and [V2X] badge; pure Canvas" style="rounded=1;arcSize=8;html=1;fillColor=#50B848;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="868" y="332" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="guard" value="the provenance guard&#10;inside CanvasWarningView:&#10;source == v2x_relayed, else a&#10;[? UNKNOWN SOURCE] marker" style="rounded=1;arcSize=8;html=1;fillColor=#50B848;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="868" y="448" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="log" value="service/AndroidR4Logger — the one log surface, tag IVI_V2X †&#10;[LINK] state=bound port=47300   ·   [RX] type=warning … cSource=v2x_relayed&#10;[DROP] reason=malformed …   ·   [UI] mode=WarningView cause=warning|user|timeout&#10;the only bridge from the plain-JVM modules to android.util.Log; today only the guard's ERROR line exists" style="rounded=1;arcSize=8;html=1;fillColor=#4A5578;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="572" width="828" height="100" as="geometry" /></mxCell>
        <mxCell id="screen" value="Screen widget&#10;external observation:&#10;the God View, recorded&#10;or screenshotted" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#c8ccd8;fontColor=#19226D;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1152" y="100" width="224" height="100" as="geometry" /></mxCell>
        <mxCell id="logcat" value="Guest logcat&#10;external observation:&#10;adb logcat -s IVI_V2X,&#10;or the Log widget" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#c8ccd8;fontColor=#19226D;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1152" y="332" width="224" height="100" as="geometry" /></mxCell>
        <mxCell id="plat" value="AAOS (Android Automotive OS) guest on the CarSky Skycraft node — platform, not our code&#10;Supplies the runtime the APK installs into: java.net sockets, the Compose/SurfaceFlinger display, logcat, and the ADB surface every install and launch arrives through.&#10;What AAOS is, and every route an Android app takes to a Skycraft node: doc/research_notes/skycraft-android-deployment-methods.md" style="rounded=1;arcSize=8;html=1;fillColor=#6b6e7b;strokeColor=none;fontColor=#ffffff;fontSize=16.8;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="816" width="1352" height="84" as="geometry" /></mxCell>
        <mxCell id="n1" value="MVC separation:&#10;data — contract models and repository; business logic — socket&#10;loop, decoder and classifier; UI logic — view-models and config;&#10;UI — MainScreen and the renderer behind the seam." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=16.1;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="688" width="520" height="100" as="geometry" /></mxCell>
        <mxCell id="n2" value="What is in the source today:&#10;Solid = in the tree. A dashed border = specified, not written.&#10;† = exists but incomplete; the box text says what is missing.&#10;WarningBannerOverlay is built and deliberately left unmounted." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e5ea;fontColor=#3d3d46;fontSize=16.1;align=left;whiteSpace=wrap;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="844" y="688" width="532" height="100" as="geometry" /></mxCell>
