{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackathon.local/schemas/r2_v2x_object.schema.json",
  "title": "R2 V2X ECU to ADA object message",
  "type": "object",
  "required": ["schemaVersion", "type", "stationId", "rxTime", "sender", "object"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "v2x_object" },
    "stationId": { "type": "integer", "minimum": 0 },
    "rxTime": { "type": "integer", "minimum": 0 },
    "sender": {
      "type": "object",
      "required": ["lat", "lon", "heading", "speed"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "heading": { "type": "number", "minimum": 0, "maximum": 360 },
        "speed": { "type": "number", "minimum": 0 }
      }
    },
    "object": {
      "type": "object",
      "required": ["objectId", "timeOfMeasurement", "distance", "position", "speed", "classification", "confidence"],
      "additionalProperties": false,
      "properties": {
        "objectId": { "type": "integer", "minimum": 0 },
        "timeOfMeasurement": { "type": "integer" },
        "distance": { "type": "number", "minimum": 0 },
        "position": {
          "type": "object",
          "required": ["x", "y", "confidence"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "speed": { "type": "number", "minimum": 0 },
        "classification": { "type": "string", "const": "vehicle" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

