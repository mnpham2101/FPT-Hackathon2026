            "version": "REPLACE_WITH_ARTIFACT_VERSION",
            "versionId": "REPLACE_WITH_VERSION_ID",
            "artifactId": "REPLACE_WITH_ARTIFACT_ID"
          },
          "prefix": "ivi",
          "gpuBackend": "virglrenderer",
          "displayWidth": 1920,
          "displayHeight": 1080
        },
        "positionX": 450,
        "positionY": -40,
        "pins": []
