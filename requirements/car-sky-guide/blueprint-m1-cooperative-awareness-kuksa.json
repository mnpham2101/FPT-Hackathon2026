{
  "version": 1,
  "exportedAt": "2026-07-29T00:00:00.000Z",
  "blueprint": {
    "name": "m1-cooperative-awareness-kuksa",
    "description": "TRIAL VARIANT of m1-cooperative-awareness (see blueprint-m1-cooperative-awareness.json) — same 4-node star topology, but the bridge is a KUKSA Databroker instead of an Ethernet Bridge, and every role node wires one `kuksa` pin (REST/import-createable pinType) instead of `ethernet` (REST/import-rejected). Goal: fully scriptable blueprint creation, no manual UI pin-wiring step. This is a studied alternative, not a replacement of the R6-frozen baseline — see carsky-kuksa-blueprint-guide.md for the feasibility verdict and the open items before adopting it. Payloads are unchanged: R1 CPM travels base64-encoded, R2/R4 travel as raw JSON text, each as one opaque VSS string signal — see vss-m1-custom-signals.json.",
    "zones": [],
    "nodes": [
