            "vss": {
              "artifactId": "REPLACE_WITH_VSS_ARTIFACT_ID",
              "versionId": "REPLACE_WITH_VSS_VERSION_ID",
              "version": "0.0.1"
            },
            "insecure": true
          }
        },
        "positionX": 0,
        "positionY": -40,
        "pins": [
          {
            "id": "pin-broker-kuksa",
            "name": "kuksa",
