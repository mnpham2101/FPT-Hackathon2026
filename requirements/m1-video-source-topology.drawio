        <mxCell id="lg01c" value="&lt;font style=&quot;font-size: 11px&quot; color=&quot;#3d3d46&quot;&gt;V2X ECU → ADA object message (JSON over UDP)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="142" y="884" width="300" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg02a" value="&lt;b&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#19226D&quot;&gt;R3&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
