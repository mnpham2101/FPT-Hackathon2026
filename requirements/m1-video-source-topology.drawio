        <mxCell id="lg01a" value="&lt;b&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#19226D&quot;&gt;R2&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
