        <mxCell id="rejected" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdf0e8;strokeColor=#F37021;strokeWidth=1.4;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
