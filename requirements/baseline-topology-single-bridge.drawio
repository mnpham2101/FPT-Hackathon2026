<mxfile host="app.diagrams.net">
  <diagram name="baseline-single-bridge" id="baseline-topology-single-bridge">
    <mxGraphModel dx="1368" dy="788" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="350" math="0" shadow="0">
      <root>
