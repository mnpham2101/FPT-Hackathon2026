        <mxCell id="bridge" value="Ethernet Bridge&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;one INPUT pin · 4 edges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="215" width="150" height="60" as="geometry" /></mxCell>

        <mxCell id="f1" value="47100" style="endArrow=classic;html=1;strokeColor=#333333;" edge="1" parent="1" source="bench" target="v2x"><mxGeometry relative="1" as="geometry" /></mxCell>
