        <mxCell id="title" value="Baseline (R6) — four nodes, one Ethernet Bridge, one subnet 10.99.0.0/24" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="620" height="20" as="geometry" /></mxCell>

