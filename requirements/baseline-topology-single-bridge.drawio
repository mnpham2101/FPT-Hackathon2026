        <mxCell id="v2x" value="V2X ECU&lt;br&gt;&lt;font color=&quot;#444444&quot;&gt;10.99.0.11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="50" width="150" height="60" as="geometry" /></mxCell>
