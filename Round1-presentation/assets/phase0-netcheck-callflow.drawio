        <mxCell id="b11" value="3 · datagram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F37021;strokeColor=#F37021;strokeWidth=1;fontColor=#ffffff;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="150" height="24" as="geometry" /></mxCell>
        <mxCell id="b12" value="4 · stamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#19226D;strokeColor=#19226D;strokeWidth=1;fontColor=#ffffff;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="150" height="24" as="geometry" /></mxCell>
        <mxCell id="b13" value="entrypoint.sh → netcheck.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cbd6;strokeWidth=1;fontColor=#3d3d46;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="216" y="172" width="168" height="32" as="geometry" /></mxCell>
        <mxCell id="b14" value="bind 0.0.0.0:47100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cbd6;strokeWidth=1;fontColor=#3d3d46;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="936" y="172" width="168" height="32" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#8a8d99;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="248" as="sourcePoint" /><mxPoint x="306" y="278" as="targetPoint" /><Array as="points"><mxPoint x="458" y="248" /><mxPoint x="458" y="278" /></Array></mxGeometry></mxCell>
        <mxCell id="t16" value="connect() on a UDP socket" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="246" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="t17" value="forces a kernel route lookup and sends nothing —" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="264" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="t18" value="an unreachable peer fails instantly, with no ICMP involved" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="280" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#F37021;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="342" as="sourcePoint" /><mxPoint x="1014" y="342" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t20" value="UDP → 10.99.0.11:47100" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#F37021;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="527" y="322" width="260" height="20" as="geometry" /></mxCell>
        <mxCell id="b21" value="seq=287|bench" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1540;strokeColor=#0E1540;strokeWidth=1;fontColor=#cfd6f5;fontSize=13;fontStyle=1;fontFamily=Consolas, monospace;" vertex="1" parent="1"><mxGeometry x="520" y="352" width="274" height="28" as="geometry" /></mxCell>
        <mxCell id="t22" value="13 bytes of ASCII · sent at HZ=1, one per second" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8a8d99;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="487" y="386" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#8a8d99;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="430" as="sourcePoint" /><mxPoint x="1026" y="464" as="targetPoint" /><Array as="points"><mxPoint x="1112" y="430" /><mxPoint x="1112" y="464" /></Array></mxGeometry></mxCell>
        <mxCell id="t24" value="the relay appends its own role, never re-encodes:" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.5;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="430" width="380" height="20" as="geometry" /></mxCell>
        <mxCell id="b25" value="data + f&quot;|{ROLE}&quot;.encode()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1540;strokeColor=#0E1540;strokeWidth=1;fontColor=#cfd6f5;fontSize=12.5;fontStyle=1;fontFamily=Consolas, monospace;" vertex="1" parent="1"><mxGeometry x="660" y="424" width="330" height="26" as="geometry" /></mxCell>
        <mxCell id="t26" value="forwarded onward to ADA on :47200 as" style="text;html=1;align=right;verticalAlign=middle;fontSize=11.5;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="460" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="b27" value="seq=287|bench|v2x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1540;strokeColor=#0E1540;strokeWidth=1;fontColor=#cfd6f5;fontSize=12;fontStyle=1;fontFamily=Consolas, monospace;" vertex="1" parent="1"><mxGeometry x="660" y="456" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="b28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f6;strokeColor=#c9cbd6;strokeWidth=1;fontColor=#19226D;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="512" width="1020" height="40" as="geometry" /></mxCell>
        <mxCell id="t29" value="Throughout, tcpdump runs in the background on both nodes, prefixing every packet line with [CAP] — proof on the wire, independent of the application's own log." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="160" y="527" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="e30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="572" as="sourcePoint" /><mxPoint x="1280" y="572" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F37021;strokeColor=#F37021;strokeWidth=1;fontColor=#19226D;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="10" height="10" as="geometry" /></mxCell>
        <mxCell id="t32" value="The accumulated stamp is the evidence: a payload reading seq=288|bench|v2x at ADA proves the datagram transited every node, not merely that one arrived from somewhere." style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="62" y="587" width="1200" height="20" as="geometry" /></mxCell>
