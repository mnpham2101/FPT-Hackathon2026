        <mxCell id="b9" value="1 · boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#19226D;strokeColor=#19226D;strokeWidth=1;fontColor=#ffffff;fontSize=12.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="150" height="24" as="geometry" /></mxCell>
