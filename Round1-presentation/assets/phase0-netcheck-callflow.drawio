        <mxCell id="t1" value="Phase 0 call flow — netcheck over UDP, bench → V2X" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="800" height="20" as="geometry" /></mxCell>
        <mxCell id="t2" value="What Phase 0 actually ran: one throwaway image on both nodes, plain ASCII payloads. No CPM, no codec, no contract on the wire." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#3d3d46;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1000" height="20" as="geometry" /></mxCell>
