        <mxCell id="b5" value="store&#10;+ admission" style="rounded=1;arcSize=10;html=1;fillColor=#33B2C1;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="96" width="210" height="56" as="geometry" /></mxCell>
