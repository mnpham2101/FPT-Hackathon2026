        <mxCell id="t1" value="Call flow 3 of 3 — the fusion tick, the assessment and the warning" style="text;html=1;align=left;verticalAlign=middle;fontSize=25.0;fontColor=#19226D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="t2" value="The tick runs on its period whether or not anything arrived, so a track can expire and risk can fall on silence alone." style="text;html=1;align=left;verticalAlign=middle;fontSize=17.0;fontColor=#6b6e7b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="1272" height="22" as="geometry" /></mxCell>
        <mxCell id="b3" value="main&#10;fusion tick" style="rounded=1;arcSize=10;html=1;fillColor=#19226D;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="200" height="56" as="geometry" /></mxCell>
