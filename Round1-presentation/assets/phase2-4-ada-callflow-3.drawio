        <mxCell id="b7" value="chained_collision&#10;+ record table" style="rounded=1;arcSize=10;html=1;fillColor=#034EA2;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="96" width="220" height="56" as="geometry" /></mxCell>
        <mxCell id="ll8" value="" style="line;strokeColor=#c9cddb;dashed=1;direction=north;html=1;" vertex="1" parent="1"><mxGeometry x="670.0" y="152" width="1" height="352" as="geometry" /></mxCell>
        <mxCell id="b9" value="output&#10;compose, build, send" style="rounded=1;arcSize=10;html=1;fillColor=#F37021;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="850" y="96" width="230" height="56" as="geometry" /></mxCell>
        <mxCell id="ll10" value="" style="line;strokeColor=#c9cddb;dashed=1;direction=north;html=1;" vertex="1" parent="1"><mxGeometry x="965.0" y="152" width="1" height="352" as="geometry" /></mxCell>
        <mxCell id="b11" value="IVI&#10;and [EVT]" style="rounded=1;arcSize=10;html=1;fillColor=#50B848;strokeColor=none;fontColor=#ffffff;fontSize=14.0;fontStyle=1;whiteSpace=wrap;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="96" width="130" height="56" as="geometry" /></mxCell>
        <mxCell id="ll12" value="" style="line;strokeColor=#c9cddb;dashed=1;direction=north;html=1;" vertex="1" parent="1"><mxGeometry x="1225.0" y="152" width="1" height="352" as="geometry" /></mxCell>
        <mxCell id="e13" value="expire tracks silent past the timeout" style="html=1;endArrow=block;endFill=1;strokeColor=#33B2C1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136.0" y="176" as="sourcePoint" /><mxPoint x="389.0" y="176" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e14" value="assess(store, record table, now)" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136.0" y="216" as="sourcePoint" /><mxPoint x="664.0" y="216" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e15" value="nearest own-sensor VehicleB, tracked relayed VehicleC" style="html=1;endArrow=block;endFill=1;strokeColor=#33B2C1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="664.0" y="254" as="sourcePoint" /><mxPoint x="401.0" y="254" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e16" value="compose d_AC, the closing rate, the time to collision, then the band" style="html=1;endArrow=block;endFill=1;strokeColor=#034EA2;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670.0" y="296" as="sourcePoint" /><mxPoint x="676.0" y="322" as="targetPoint" /><Array as="points"><mxPoint x="800.0" y="296" /><mxPoint x="800.0" y="322" /></Array></mxGeometry></mxCell>
        <mxCell id="e17" value="no own-sensor VehicleB: rationale b_unknown, risk stays low" style="html=1;endArrow=block;endFill=1;strokeColor=#F37021;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670.0" y="356" as="sourcePoint" /><mxPoint x="664.0" y="382" as="targetPoint" /><Array as="points"><mxPoint x="520.0" y="356" /><mxPoint x="520.0" y="382" /></Array></mxGeometry></mxCell>
        <mxCell id="e18" value="a risk finding, once the change has held for the dwell" style="html=1;endArrow=block;endFill=1;strokeColor=#F37021;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676.0" y="418" as="sourcePoint" /><mxPoint x="959.0" y="418" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e19" value="one warning datagram,&#10;and r4_tx carrying its body" style="html=1;endArrow=block;endFill=1;strokeColor=#50B848;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13.2;fontColor=#3d3d46;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="971.0" y="456" as="sourcePoint" /><mxPoint x="1219.0" y="456" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b20" value="Emission is edge-triggered in both directions: every committed change of the risk state for one warning type and track sends exactly one warning event, and steady state sends&#10;nothing. The message set carries no explicit clear event, so the transition back down is how the display learns to stop warning.&#10;The plugin never emits. It returns a finding and the output stage decides transport, which is what keeps the rules replaceable without touching the wire." style="rounded=1;arcSize=8;html=1;fillColor=#f2f4f9;strokeColor=#e3e6f0;fontColor=#3d3d46;fontSize=13.2;fontStyle=0;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="496" width="1260" height="88" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
