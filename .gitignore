tmp/
.claude/references/
.claude/prompts/scratchpad-*/

# Android / Gradle
.gradle/
build/
local.properties
.idea/
*.iml
captures/
.kotlin/

# AG-Kit, agent files & skills (local only, do not push to git)
.agents/
.temp_ag_kit/
skills-lock.json
.DS_Store
.cursor/

# local credentials - never commit
secrets/

# apk-uploader - the organizers' tunnel CLI stays local. It is 126 MB of vendored
# binaries that git cannot delta-compress, so committing it charges every clone
# forever for a file the organizers hand out. Unpack their zip here instead.
# The built APK stays local too: CI publishes it as the app-debug-apk artifact.
tools/apk-uploader/reach_be/
tools/apk-uploader/*.apk
tools/apk-uploader/logs/
# collected run evidence - logs, dumps and pcaps; kept with the delivery report, not in git.
# The log collector writes ./test-report/<test-name>/ relative to wherever it is run, so the
# pattern is unanchored rather than tied to one folder.
test-report/

# AG-Kit temporary & runtime files
.temp_ag_kit/
.agents/.ag-kit/backups/
.agents/.ag-kit/conflicts/
.agents/.ag-kit/runs/
.temp_backup/

# Python
__pycache__/
*.pyc

# ADA local runtime/test artifacts
ADA_ECU/local-data/
ADA_ECU/tools/__pycache__/
ADA_ECU/build-runtime/
ADA_ECU/.venv/
ADA_ECU/models/*.onnx
!ADA_ECU/models/yolo11n.onnx
ada-events.jsonl

# Raw downloaded footage - the encoded clip is committed, its source is not
ADA_ECU/media/source/

# generated by ADA_ECU/tools/make_sample_video.py - CI fixture output, never committed
sample_video*.mp4

# Generated source references for the sketch backdrop - the derived
# bg-sketch-board.jpg is committed, its AI-generated sources are not
website/assets/Gemini_Generated_Image_v1.png
website/assets/Gemini_Generated_Image_v2.png

# website/build-pages.py --bundle output: a derived, self-contained copy of the site
dist/

# website/pages/ is generated in full by website/build-pages.py — the document
# pages, the node mount pages, and the images they render. Rebuild, never commit.
website/pages/
