{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackathon.local/schemas/r4_warning.schema.json",
  "title": "R4 ADA to IVI warning message",
  "type": "object",
  "required": ["schemaVersion", "type", "warningType", "riskState", "object", "geometry"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "warning" },
    "warningType": { "type": "string" },
    "riskState": { "type": "string", "enum": ["low", "medium", "high"] },
    "object": { "$ref": "r3_tracked_object.schema.json" },
    "trackedObjects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "r3_tracked_object.schema.json" }
    },
    "geometry": {
      "type": "object",
      "required": ["ego", "vehicleB", "vehicleC"],
      "additionalProperties": false,
      "properties": {
        "ego": { "$ref": "#/$defs/point" },
        "vehicleB": { "$ref": "#/$defs/point" },
        "vehicleC": { "$ref": "#/$defs/point" }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    }
  }
}
